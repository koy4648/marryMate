# Copy this file to backend/.env and replace every CHANGE_ME value.
# Never commit backend/.env.

MARRY_MATE_DB_NAME=marry_mate
MARRY_MATE_DB_USER=marry_mate
MARRY_MATE_DB_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
MARRY_MATE_DB_ROOT_PASSWORD=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_PASSWORD

# These ports listen on 127.0.0.1 only. They are not exposed to the LAN.
MARRY_MATE_DB_LOCAL_PORT=3306
MARRY_MATE_API_LOCAL_PORT=8080

# Comma-separated frontend origins. Do not add a trailing slash.
MARRY_MATE_CORS_ORIGINS=https://wedget-venue-tour.koy4648.chatgpt.site,http://localhost:3000,http://localhost:3001

# Create this token in Cloudflare Zero Trust after the API and DB work locally.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_WITH_CLOUDFLARE_TUNNEL_TOKEN
